{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Kejue",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#E8663C",
    "light": "#F0845E",
    "dark": "#D14E24"
  },
  "appearance": {
    "default": "system"
  },
  "api": {
    "baseUrl": "https://api.kejue.co/api/v1",
    "auth": {
      "method": "key",
      "name": "X-API-Key"
    },
    "playground": {
      "mode": "simple"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book",
        "groups": [
          {
            "group": "Getting Started",
            "pages": ["introduction"]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "core-concepts/personas",
              "core-concepts/prompting",
              "core-concepts/tools",
              "core-concepts/knowledge",
              "core-concepts/memory"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/dynamic-variables",
              "guides/prompting-for-tools",
              "guides/webhooks",
              "guides/inbound-routing",
              "guides/inject-context"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "icon": "square-terminal",
        "openapi": "openapi.json"
      }
    ]
  },
  "footer": {
    "socials": {
      "website": "https://kejue.co"
    }
  }
}
